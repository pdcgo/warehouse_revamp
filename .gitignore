# graphify knowledge graph — generated, large (infra's graph.json is ~55MB), rebuildable
graphify-out/

# python venv that hosts the graphify CLI
.venv/

# backend
backend/bin/
backend/*.exe

# frontend
frontend/node_modules/
frontend/dist/
frontend/test-results/
# the e2e setup's saved sign-ins (a token per role, per worker — frontend/e2e/session.ts)
frontend/e2e/.auth/
# a parallel e2e run's per-worker run locks (frontend/e2e/lock.ts)
frontend/.e2e-lock.*
frontend/playwright-report/
frontend/storybook-static/

# local postgres data (docker-compose bind mount)
development_data/

# env
.env
.env.local

# run-warehouse-revamp driver output (screenshots, server logs, tracked pids)
.claude/skills/run-warehouse-revamp/shots/
.claude/skills/run-warehouse-revamp/logs/
.claude/skills/run-warehouse-revamp/.driver-state.json

# audit-frontend-structure output (regenerated on every run)
.claude/skills/audit-frontend-structure/last-report.md

# san remote's persisted token (--persist-token) — a live credential, never committed
.san/

app_development.exe
# go build ./tools/san from the repo root
/san.exe

# san test: the measured-testing record (the-full-e2e-waits-for-a-measured-yes) — fingerprints, runs, logs; local only
/e2e_report/
